/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "Dynamai usa Automazione per spostare file, inviare elementi al Cestino, aprire i comandi richiesti e controllare la riproduzione nelle tue app multimediali. SIRI la usa anche per leggere, scrivere e inviare email in Mail quando lo chiedi.";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "Dynamai usa l'audio di ogni app per regolarne il volume nel mixer, per muovere le barre musicali di Dynamic Island e per includere l'audio del Mac nelle registrazioni dello schermo che avvii. Nulla lascia il tuo Mac.";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "Dynamai usa il Bluetooth solo per leggere la batteria delle periferiche connesse. Nulla lascia il tuo Mac.";

/* macOS Microphone permission prompt. */
"NSMicrophoneUsageDescription" = "Dynamai registra il microfono solo quando lo attivi per una registrazione dello schermo. L’audio resta sul tuo Mac, a meno che tu scelga di creare un link temporaneo. Ascolta anche mentre detti un messaggio a VERTUS nella Dynamic Island.";

/* macOS Speech Recognition permission prompt. */
"NSSpeechRecognitionUsageDescription" = "Dynamai trasforma la tua voce in testo solo mentre detti un messaggio a VERTUS nella Dynamic Island. Il riconoscimento avviene su questo Mac quando è supportato; altrimenti l’audio viene elaborato da Apple.";

/* macOS Camera permission prompt. */
"NSCameraUsageDescription" = "Dynamai mostra la fotocamera solo nella finestra di anteprima che apri, così puoi controllare il tuo aspetto prima di una chiamata. Nulla viene registrato e nulla lascia il tuo Mac.";

/* macOS Downloads folder permission prompt. */
"NSDownloadsFolderUsageDescription" = "Dynamai controlla i metadati locali in Download per esaminare, organizzare o spostare nel Cestino solo i file WhatsApp confermati scelti da te. La Pulizia cerca anche gli screenshot dimenticati se li salvi qui.";

/* macOS user-selected organizer destination prompts. */
"NSDesktopFolderUsageDescription" = "Dynamai organizza i download WhatsApp confermati in una cartella di destinazione scelta esplicitamente da te. La Pulizia cerca anche gli screenshot dimenticati se li salvi qui.";
"NSDocumentsFolderUsageDescription" = "Dynamai organizza i download WhatsApp confermati in una cartella di destinazione scelta esplicitamente da te. La Pulizia cerca anche gli screenshot dimenticati se li salvi qui.";
"NSNetworkVolumesUsageDescription" = "Dynamai organizza i download WhatsApp confermati in una cartella di destinazione scelta esplicitamente da te. La Pulizia cerca anche gli screenshot dimenticati se li salvi qui.";
"NSRemovableVolumesUsageDescription" = "Dynamai organizza i download WhatsApp confermati in una cartella di destinazione scelta esplicitamente da te. La Pulizia cerca anche gli screenshot dimenticati se li salvi qui.";
"NSCalendarsFullAccessUsageDescription" = "Mostra i tuoi prossimi appuntamenti nella parte superiore dello schermo. Gli eventi del calendario restano su questo Mac.";
