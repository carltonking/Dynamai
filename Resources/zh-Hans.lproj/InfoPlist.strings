/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "Dynamai 使用自动化来移动文件、将项目移到废纸篓、打开请求的命令以及控制媒体 App 的播放。SIRI 也会在你要求时，用它在“邮件”中阅读、撰写和发送电子邮件。";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "Dynamai 使用各个 App 的音频，用于在混音器中调节它们的音量、驱动 Dynamic Island 的音乐音柱，以及在你开始的屏幕录制中加入 Mac 的声音。不会有任何数据离开你的 Mac。";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "Dynamai 仅使用蓝牙读取已连接外设的电池电量。不会有任何数据离开你的 Mac。";

/* macOS Microphone permission prompt. */
"NSMicrophoneUsageDescription" = "Dynamai 只会在你为屏幕录制开启麦克风时录制声音。除非你选择创建临时链接，否则音频只会保留在 Mac 上。在灵动岛中向 Hermes 听写消息时也会聆听。";

/* macOS Speech Recognition permission prompt. */
"NSSpeechRecognitionUsageDescription" = "仅当你在灵动岛中向 Hermes 听写消息时，Dynamai 才会把你说的话转为文字。如果此 Mac 支持，识别在本机进行；否则由 Apple 处理音频。";

/* macOS Camera permission prompt. */
"NSCameraUsageDescription" = "Dynamai 仅在你打开的预览窗口中显示摄像头画面，方便你在通话前查看自己的状态。不会录制任何内容，也不会有任何数据离开你的 Mac。";

/* macOS Downloads folder permission prompt. */
"NSDownloadsFolderUsageDescription" = "Dynamai 检查下载文件夹中的本地元数据，仅查看、整理或移到废纸篓你选择的已确认 WhatsApp 文件。如果你把截图保存在这里，清理功能还会查找被遗忘的截图。";

/* macOS user-selected organizer destination prompts. */
"NSDesktopFolderUsageDescription" = "Dynamai 将确认的 WhatsApp 下载整理到你明确选择的目标文件夹中。如果你把截图保存在这里，清理功能还会查找被遗忘的截图。";
"NSDocumentsFolderUsageDescription" = "Dynamai 将确认的 WhatsApp 下载整理到你明确选择的目标文件夹中。如果你把截图保存在这里，清理功能还会查找被遗忘的截图。";
"NSNetworkVolumesUsageDescription" = "Dynamai 将确认的 WhatsApp 下载整理到你明确选择的目标文件夹中。如果你把截图保存在这里，清理功能还会查找被遗忘的截图。";
"NSRemovableVolumesUsageDescription" = "Dynamai 将确认的 WhatsApp 下载整理到你明确选择的目标文件夹中。如果你把截图保存在这里，清理功能还会查找被遗忘的截图。";
"NSCalendarsFullAccessUsageDescription" = "在屏幕顶部显示即将到来的日程。日历事件仅保留在这台 Mac 上。";
