/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "Dynamai usa Automatización para mover archivos, enviar elementos a la Papelera, abrir los comandos solicitados y controlar la reproducción en tus apps multimedia. SIRI también la usa para leer, escribir y enviar correo en Mail cuando se lo pides.";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "Dynamai usa el audio de cada app para ajustar su volumen en el mezclador, para mover las barras de música de Dynamic Island y para incluir el sonido del Mac en las grabaciones de pantalla que inicies. Nada sale de tu Mac.";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "Dynamai usa Bluetooth solo para leer la batería de los periféricos conectados. Nada sale de tu Mac.";

/* macOS Microphone permission prompt. */
"NSMicrophoneUsageDescription" = "Dynamai graba tu micrófono solo cuando lo activas para una grabación de pantalla. El audio se queda en tu Mac salvo que elijas crear un enlace temporal. También escucha mientras dictas un mensaje a VERTUS en la Dynamic Island.";

/* macOS Speech Recognition permission prompt. */
"NSSpeechRecognitionUsageDescription" = "Dynamai convierte lo que dices en texto solo mientras dictas un mensaje a VERTUS en la Dynamic Island. El reconocimiento se hace en este Mac cuando es compatible; si no, Apple procesa el audio.";

/* macOS Camera permission prompt. */
"NSCameraUsageDescription" = "Dynamai muestra tu cámara solo en la ventana de vista previa que abres, para que compruebes cómo te ves antes de una llamada. No se graba nada ni nada sale de tu Mac.";

/* macOS Downloads folder permission prompt. */
"NSDownloadsFolderUsageDescription" = "Dynamai consulta metadatos locales en Descargas para revisar, organizar o enviar a la Papelera solo los archivos confirmados de WhatsApp que tú elijas. Limpieza también busca capturas olvidadas si guardas tus capturas aquí.";

/* macOS user-selected organizer destination prompts. */
"NSDesktopFolderUsageDescription" = "Dynamai organiza las descargas confirmadas de WhatsApp en una carpeta de destino que tú eliges expresamente. Limpieza también busca capturas olvidadas si guardas tus capturas aquí.";
"NSDocumentsFolderUsageDescription" = "Dynamai organiza las descargas confirmadas de WhatsApp en una carpeta de destino que tú eliges expresamente. Limpieza también busca capturas olvidadas si guardas tus capturas aquí.";
"NSNetworkVolumesUsageDescription" = "Dynamai organiza las descargas confirmadas de WhatsApp en una carpeta de destino que tú eliges expresamente. Limpieza también busca capturas olvidadas si guardas tus capturas aquí.";
"NSRemovableVolumesUsageDescription" = "Dynamai organiza las descargas confirmadas de WhatsApp en una carpeta de destino que tú eliges expresamente. Limpieza también busca capturas olvidadas si guardas tus capturas aquí.";
"NSCalendarsFullAccessUsageDescription" = "Muestra tus próximas citas en la parte superior de la pantalla. Los eventos del calendario se quedan en este Mac.";
