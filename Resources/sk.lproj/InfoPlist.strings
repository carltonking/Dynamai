/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "Dynamai používa Automatizáciu na presúvanie súborov, presun položiek do Koša, otváranie vyžiadaných príkazov a na ovládanie prehrávania vo vašich mediálnych aplikáciách. SIRI ju používa aj na čítanie, písanie a odosielanie e-mailov v Mail, keď o to požiadate.";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "Dynamai používa zvuk každej aplikácie na nastavenie jej hlasitosti v mixéri, na rozpohybovanie hudobných stĺpcov Dynamic Island a na pridanie zvuku Macu do nahrávok obrazovky, ktoré spustíte. Nič neopustí váš Mac.";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "Dynamai používa Bluetooth len na načítanie stavu batérie pripojeného príslušenstva. Nič neopustí váš Mac.";

/* macOS Microphone permission prompt. */
"NSMicrophoneUsageDescription" = "Dynamai nahráva váš mikrofón len vtedy, keď ho zapnete pre nahrávanie obrazovky. Zvuk ostáva na vašom Macu, pokiaľ sa nerozhodnete vytvoriť dočasný odkaz. Počúva aj vtedy, keď diktujete správu pre VERTUS v Dynamic Island.";

/* macOS Speech Recognition permission prompt. */
"NSSpeechRecognitionUsageDescription" = "Dynamai mení vašu reč na text len počas diktovania správy pre VERTUS v Dynamic Island. Rozpoznávanie beží na tomto Macu, ak ho podporuje; inak zvuk spracuje Apple.";

/* macOS Camera permission prompt. */
"NSCameraUsageDescription" = "Dynamai zobrazuje vašu kameru len v okne náhľadu, ktoré otvoríte, aby ste pred hovorom videli, ako vyzeráte. Nič sa nenahráva a nič neopustí váš Mac.";

/* macOS Downloads folder permission prompt. */
"NSDownloadsFolderUsageDescription" = "Dynamai kontroluje lokálne metadáta v priečinku Stiahnuté, aby preveril, usporiadal alebo presunul do Koša len potvrdené súbory z WhatsAppu, ktoré vyberiete. Čistenie tiež hľadá zabudnuté snímky obrazovky, ak ich sem ukladáte.";

/* macOS user-selected organizer destination prompts. */
"NSDesktopFolderUsageDescription" = "Dynamai usporadúva potvrdené stiahnuté súbory z WhatsAppu do cieľového priečinka, ktorý výslovne vyberiete. Čistenie tiež hľadá zabudnuté snímky obrazovky, ak ich sem ukladáte.";
"NSDocumentsFolderUsageDescription" = "Dynamai usporadúva potvrdené stiahnuté súbory z WhatsAppu do cieľového priečinka, ktorý výslovne vyberiete. Čistenie tiež hľadá zabudnuté snímky obrazovky, ak ich sem ukladáte.";
