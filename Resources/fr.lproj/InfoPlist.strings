/* macOS Automation permission prompt. */
"NSAppleEventsUsageDescription" = "Dynamai utilise Automatisation pour déplacer des fichiers, placer des éléments dans la Corbeille, ouvrir les commandes demandées et contrôler la lecture dans vos apps multimédias. SIRI l’utilise aussi pour lire, rédiger et envoyer des e-mails dans Mail lorsque vous le demandez.";

/* macOS Screen & System Audio Recording permission prompt. */
"NSAudioCaptureUsageDescription" = "Dynamai utilise le son de chaque app pour régler son volume dans le mixeur, pour animer les barres de musique de Dynamic Island et pour inclure le son du Mac dans les enregistrements d'écran que vous lancez. Rien ne quitte votre Mac.";

/* macOS Bluetooth permission prompt. */
"NSBluetoothAlwaysUsageDescription" = "Dynamai utilise le Bluetooth uniquement pour lire la batterie des périphériques connectés. Rien ne quitte votre Mac.";

/* macOS Microphone permission prompt. */
"NSMicrophoneUsageDescription" = "Dynamai enregistre votre micro uniquement quand vous l’activez pour un enregistrement d’écran. Le son reste sur votre Mac, sauf si vous créez un lien temporaire. Il écoute aussi pendant que vous dictez un message à VERTUS dans la Dynamic Island.";

/* macOS Speech Recognition permission prompt. */
"NSSpeechRecognitionUsageDescription" = "Dynamai transforme votre voix en texte uniquement pendant que vous dictez un message à VERTUS dans la Dynamic Island. La reconnaissance se fait sur ce Mac quand il la prend en charge ; sinon, Apple traite l’audio.";

/* macOS Camera permission prompt. */
"NSCameraUsageDescription" = "Dynamai affiche votre caméra uniquement dans la fenêtre d'aperçu que vous ouvrez, pour vérifier votre apparence avant un appel. Rien n'est enregistré et rien ne quitte votre Mac.";

/* macOS Downloads folder permission prompt. */
"NSDownloadsFolderUsageDescription" = "Dynamai consulte les métadonnées locales de Téléchargements pour examiner, organiser ou placer dans la Corbeille uniquement les fichiers WhatsApp confirmés que vous choisissez. Nettoyage cherche aussi les captures d’écran oubliées si vous les enregistrez ici.";

/* macOS user-selected organizer destination prompts. */
"NSDesktopFolderUsageDescription" = "Dynamai organise les téléchargements WhatsApp confirmés dans un dossier de destination que vous choisissez explicitement. Nettoyage cherche aussi les captures d’écran oubliées si vous les enregistrez ici.";
"NSDocumentsFolderUsageDescription" = "Dynamai organise les téléchargements WhatsApp confirmés dans un dossier de destination que vous choisissez explicitement. Nettoyage cherche aussi les captures d’écran oubliées si vous les enregistrez ici.";
"NSNetworkVolumesUsageDescription" = "Dynamai organise les téléchargements WhatsApp confirmés dans un dossier de destination que vous choisissez explicitement. Nettoyage cherche aussi les captures d’écran oubliées si vous les enregistrez ici.";
"NSRemovableVolumesUsageDescription" = "Dynamai organise les téléchargements WhatsApp confirmés dans un dossier de destination que vous choisissez explicitement. Nettoyage cherche aussi les captures d’écran oubliées si vous les enregistrez ici.";
"NSCalendarsFullAccessUsageDescription" = "Affiche vos prochains rendez-vous en haut de l’écran. Les événements du calendrier restent sur ce Mac.";
