# Copy to /etc/dynamai-agent.env on the VM (root-owned, mode 0600).
# Never commit a filled copy.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
DYNAMAI_HOST=127.0.0.1
DYNAMAI_PORT=8787
DYNAMAI_DATA_DIR=/var/lib/dynamai-agent
DYNAMAI_AGENT_NAME=Dynamai
# Optional, later:
# SENDBLUE_API_KEY=
# SENDBLUE_API_SECRET=

# Photon / Spectrum iMessage bridge lives in a separate env file:
# /etc/dynamai-photon.env (root-owned, mode 0600). See channels/photon/.
# SPECTRUM_PROJECT_ID=
# SPECTRUM_PROJECT_SECRET=
# DYNAMAI_HUB_URL=http://127.0.0.1:8787
# DYNAMAI_TOKEN_FILE=/var/lib/dynamai-agent/.vertus/token
# PHOTON_ALLOWLIST=+19142632426
